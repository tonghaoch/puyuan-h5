{
  "name": "puyuan-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "art:generate": "python3 scripts/generate-map.py && python3 scripts/prepare-reference-map.py",
    "format": "prettier --write src tests scripts/capture.mjs vite.config.ts playwright.config.ts tsconfig.json package.json index.html",
    "geo:package": "python3 scripts/package-geodata.py",
    "art:reference": "python3 scripts/prepare-reference-map.py"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
