{
  "name": "puyuan-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "art:generate": "python3 scripts/generate-map.py && npm run art:landscape && npm run art:models && npm run art:meadow && npm run art:scenes",
    "format": "prettier --write src tests scripts/*.mjs vite.config.ts playwright.config.ts tsconfig.json package.json index.html",
    "geo:package": "python3 scripts/package-geodata.py",
    "art:reference": "python3 scripts/prepare-reference-map.py",
    "art:landscape": "python3 scripts/generate-landscape.py",
    "art:geometry": "python3 scripts/generate-roof-volumes.py",
    "art:scenes": "python3 scripts/finalize-architecture.py",
    "art:models": "python3 scripts/generate-landmarks.py && node scripts/render-landmarks.mjs",
    "art:meadow": "python3 scripts/generate-meadow.py",
    "art:trace": "python3 scripts/trace-architecture.py && python3 scripts/enrich-architecture.py"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
